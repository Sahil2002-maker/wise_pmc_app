<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">test.pmc.wisehome.in</domain>
        <trust-anchors>
            <!-- Trust system CAs -->
            <certificates src="system"/>
            <!-- Also trust user-installed CAs (useful for self-signed test certs) -->
            <certificates src="user"/>
        </trust-anchors>
    </domain-config>
</network-security-config>